// ==========================================================================
// Sales & Profitability Intelligence System - DAX measure library (v2)
//
// Create these measures in a dedicated, empty table named _Measures.
// "Folder" = Display Folder in Power BI; "Format" = format string to apply.
// Explanations, common mistakes and validation steps: docs/dax_guide.md
//
// Rules followed throughout:
//   1. Ratios are ratios of sums: DIVIDE ( SUM ( x ), SUM ( y ) ). Never average a
//      percentage, and never store a ratio in a calculated column.
//   2. DIVIDE () instead of "/": empty or zero denominators return BLANK, not an error.
//   3. Measures build on measures ([Revenue], [Profit] ...) so each rule exists once.
//   4. Scope (core vs all countries) is a report-level filter on
//      fct_sales[is_core_scope] = 1, not hard-coded into measures.
//   5. dim_date is marked as the date table; time intelligence uses dim_date[date].
//   6. Prior-year comparisons are only shown for ONE year at a time (see
//      [PY Comparison Valid]); across several years a "prior year" is not defined.
// ==========================================================================


// ---------- Folder: 1 Base ----------------------------------------------

Revenue =
SUM ( fct_sales[sales] )
// Format: #,0 | Total sales: net revenue after discount (A1), before returns (A3).

Profit =
SUM ( fct_sales[profit] )
// Format: #,0 | Total profit as recorded in the source.

Units Sold =
SUM ( fct_sales[quantity] )
// Format: #,0 | Total quantity.

Orders =
DISTINCTCOUNT ( fct_sales[order_id] )
// Format: #,0 | Total orders: distinct order IDs (one order has several lines).

Customers =
DISTINCTCOUNT ( fct_sales[customer_key] )
// Format: #,0 | Total customers with at least one order line in the filter context.

Valid Customers =
CALCULATE ( [Customers], dim_customer[is_excluded_from_customer_analysis] = 0 )
// Format: #,0 | Customers excluding placeholder and identity-anomaly records (DQ05, DQ06).

Order Lines =
COUNTROWS ( fct_sales )
// Format: #,0 | Number of order lines (the grain of the fact table).

Gross Sales =
SUM ( fct_sales[gross_sales] )
// Format: #,0 | Implied list value before discount (A1, A4).

Discount Amount =
SUM ( fct_sales[discount_amount] )
// Format: #,0 | Value of discount given away (gross sales - revenue).


// ---------- Folder: 2 Ratios ---------------------------------------------

Profit Margin % =
DIVIDE ( [Profit], [Revenue] )
// Format: 0.0% | Profit as a share of revenue (ratio of sums).

Average Order Value =
DIVIDE ( [Revenue], [Orders] )
// Format: #,0.00 | Revenue per distinct order.

Effective Discount % =
DIVIDE ( [Discount Amount], [Gross Sales] )
// Format: 0.0% | Average discount (primary): share of list value given away.

Average Line Discount % =
AVERAGE ( fct_sales[discount_rate] )
// Format: 0.0% | Average discount (secondary): simple mean of line discount rates.

Discounted Line Share % =
DIVIDE ( CALCULATE ( [Order Lines], fct_sales[discount_rate] > 0 ), [Order Lines] )
// Format: 0.0% | Share of order lines sold with any discount.

Profit per Order =
DIVIDE ( [Profit], [Orders] )
// Format: #,0.00 | Average profit earned per order.

Profit per Customer =
DIVIDE (
    CALCULATE ( [Profit], dim_customer[is_excluded_from_customer_analysis] = 0 ),
    [Valid Customers]
)
// Format: #,0.00 | Profit of valid customers / number of valid customers (same population).

Revenue per Customer =
DIVIDE (
    CALCULATE ( [Revenue], dim_customer[is_excluded_from_customer_analysis] = 0 ),
    [Valid Customers]
)
// Format: #,0 | Revenue of valid customers / number of valid customers.

Share of Revenue % =
DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED () ) )
// Format: 0.0% | Share of the total currently visible (after slicers).

Share of Profit % =
DIVIDE ( [Profit], CALCULATE ( [Profit], ALLSELECTED () ) )
// Format: 0.0% | Share of the visible profit total.

Share of Lines % =
DIVIDE ( [Order Lines], CALCULATE ( [Order Lines], ALLSELECTED () ) )
// Format: 0.0% | Share of the visible order lines.


// ---------- Folder: 3 Time Intelligence -------------------------------------

Last Sales Date Key =
CALCULATE ( MAX ( fct_sales[order_date_key] ), REMOVEFILTERS () )
// Format: 0 | Helper (hide): the last order date in the data, as yyyymmdd.

PY Comparison Valid =
HASONEVALUE ( dim_date[year] )
    && MIN ( dim_date[date_key] ) <= [Last Sales Date Key]
// Format: True/False | Helper (hide): TRUE when one year (or a period inside one year) is in context and it is not after the data ends.

Revenue PY =
IF ( [PY Comparison Valid], CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: #,0 | Revenue in the same period one year earlier.

Profit PY =
IF ( [PY Comparison Valid], CALCULATE ( [Profit], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: #,0 | Profit in the same period one year earlier.

Revenue Growth % =
VAR _cy = [Revenue]
VAR _py = [Revenue PY]
RETURN
    IF ( NOT ISBLANK ( _cy ) && _py > 0, DIVIDE ( _cy - _py, _py ) )
// Format: 0.0% | Sales growth / YoY sales growth: change vs the same period last year.

Profit Growth % =
VAR _cy = [Profit]
VAR _py = [Profit PY]
RETURN
    IF ( NOT ISBLANK ( _cy ) && _py > 0, DIVIDE ( _cy - _py, _py ) )
// Format: 0.0% | Profit growth / YoY profit growth. BLANK when prior-year profit <= 0.

Profit Change =
IF ( [PY Comparison Valid], [Profit] - [Profit PY] )
// Format: #,0 | Absolute profit change vs prior year; meaningful even when the base is negative.

Profit Margin % PY =
IF ( [PY Comparison Valid], CALCULATE ( [Profit Margin %], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: 0.0% | Margin in the same period one year earlier.

Margin Change pp =
VAR _py = [Profit Margin % PY]
RETURN
    IF ( NOT ISBLANK ( _py ) && NOT ISBLANK ( [Revenue] ), [Profit Margin %] - _py )
// Format: +0.0%;-0.0% | Change in margin in percentage points (not a % growth).

Orders PY =
IF ( [PY Comparison Valid], CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: #,0 | Orders in the same period one year earlier.

Orders Growth % =
VAR _py = [Orders PY]
RETURN
    IF ( _py > 0 && NOT ISBLANK ( [Orders] ), DIVIDE ( [Orders] - _py, _py ) )
// Format: 0.0% | Change in orders vs the same period last year.

Customers PY =
IF ( [PY Comparison Valid], CALCULATE ( [Customers], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: #,0 | Customers in the same period one year earlier.

Customers Growth % =
VAR _py = [Customers PY]
RETURN
    IF ( _py > 0 && NOT ISBLANK ( [Customers] ), DIVIDE ( [Customers] - _py, _py ) )
// Format: 0.0% | Change in active customers vs the same period last year.

Units Sold PY =
IF ( [PY Comparison Valid], CALCULATE ( [Units Sold], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: #,0 | Units in the same period one year earlier.

Units Growth % =
VAR _py = [Units Sold PY]
RETURN
    IF ( _py > 0 && NOT ISBLANK ( [Units Sold] ), DIVIDE ( [Units Sold] - _py, _py ) )
// Format: 0.0% | Change in units vs the same period last year.

Average Order Value PY =
IF ( [PY Comparison Valid], CALCULATE ( [Average Order Value], SAMEPERIODLASTYEAR ( dim_date[date] ) ) )
// Format: #,0.00 | AOV in the same period one year earlier.

AOV Growth % =
VAR _py = [Average Order Value PY]
RETURN
    IF ( _py > 0 && NOT ISBLANK ( [Average Order Value] ), DIVIDE ( [Average Order Value] - _py, _py ) )
// Format: 0.0% | Change in AOV vs the same period last year.

Revenue Rolling 12M =
IF ( MIN ( dim_date[date_key] ) <= [Last Sales Date Key],
     CALCULATE ( [Revenue], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ) ) )
// Format: #,0 | Revenue of the 12 months ending at the current point.

Profit Rolling 12M =
IF ( MIN ( dim_date[date_key] ) <= [Last Sales Date Key],
     CALCULATE ( [Profit], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ) ) )
// Format: #,0 | Profit of the 12 months ending at the current point.

Profit Margin Rolling 12M =
DIVIDE ( [Profit Rolling 12M], [Revenue Rolling 12M] )
// Format: 0.0% | 12-month margin; smooths monthly volatility.


// ---------- Folder: 4 Losses & break-even -------------------------------------

Loss Amount =
CALCULATE ( [Profit], fct_sales[is_loss_line] = 1 )
// Format: #,0 | Sum of negative line profits (a negative number).

Loss Line Share % =
DIVIDE ( CALCULATE ( [Order Lines], fct_sales[is_loss_line] = 1 ), [Order Lines] )
// Format: 0.0% | Share of order lines that lose money.

Revenue Beyond Break-even =
CALCULATE ( [Revenue], fct_sales[is_beyond_break_even] = 1 )
// Format: #,0 | Revenue on lines discounted beyond the product's list margin (Phase 6).

Profit Beyond Break-even =
CALCULATE ( [Profit], fct_sales[is_beyond_break_even] = 1 )
// Format: #,0 | Profit on those lines (always <= 0).

Beyond Break-even Revenue % =
DIVIDE ( [Revenue Beyond Break-even], [Revenue] )
// Format: 0.0% | Share of revenue sold beyond break-even.

Portfolio Margin % =
CALCULATE ( [Profit Margin %], REMOVEFILTERS ( dim_product ), REMOVEFILTERS ( dim_customer ) )
// Format: 0.0% | Hurdle: margin of all products and customers under the date and region filters.

Margin vs Visible Total pp =
[Profit Margin %] - CALCULATE ( [Profit Margin %], ALLSELECTED () )
// Format: +0.0%;-0.0% | Heat maps: each cell vs the visible total.


// ---------- Folder: 5 Products, customers & rules ---------------------------

Products Sold =
DISTINCTCOUNT ( fct_sales[product_key] )
// Format: #,0 | Distinct products sold.

Loss-making Products =
COUNTROWS ( FILTER ( VALUES ( fct_sales[product_key] ), [Profit] < 0 ) )
// Format: #,0 | Products with negative profit in the filter context.

Loss from Loss-making Products =
SUMX ( FILTER ( VALUES ( fct_sales[product_key] ), [Profit] < 0 ), [Profit] )
// Format: #,0 | Combined profit of those products.

Product Profit Rank =
RANKX ( ALLSELECTED ( dim_product[product_label] ), [Profit], , DESC, DENSE )
// Format: 0 | Rank by absolute profit among visible products.

Unprofitable Customers =
CALCULATE (
    COUNTROWS ( FILTER ( VALUES ( fct_sales[customer_key] ), [Profit] < 0 ) ),
    dim_customer[is_excluded_from_customer_analysis] = 0
)
// Format: #,0 | Valid customers with negative profit.

Top 10% Customer Profit Share =
VAR _cust = CALCULATETABLE ( VALUES ( fct_sales[customer_key] ),
                             dim_customer[is_excluded_from_customer_analysis] = 0 )
VAR _n = ROUNDUP ( COUNTROWS ( _cust ) * 0.1, 0 )
VAR _top = TOPN ( _n, _cust, [Profit], DESC )
RETURN
    DIVIDE ( SUMX ( _top, [Profit] ), SUMX ( _cust, [Profit] ) )
// Format: 0.0% | Share of customer profit earned by the top 10% of customers.

Loss-making Rules =
VAR _cells = SUMMARIZE ( fct_sales, dim_location[state_province], dim_product[sub_category] )
RETURN
    COUNTROWS ( FILTER ( _cells, [Profit] < 0 ) )
// Format: #,0 | State x sub-category discount rules with negative profit.

Loss from Loss-making Rules =
VAR _cells = SUMMARIZE ( fct_sales, dim_location[state_province], dim_product[sub_category] )
RETURN
    SUMX ( FILTER ( _cells, [Profit] < 0 ), [Profit] )
// Format: #,0 | Combined profit of those rules.


// ---------- Folder: 6 Formatting & labels ----------------------------------

Profit Colour =
IF ( [Profit] < 0, "#C0392B", "#1D7874" )
// Use: conditional formatting (field value) - red for loss, teal for profit.

Margin Colour =
IF ( [Profit Margin %] < [Portfolio Margin %], "#C0392B", "#1D7874" )
// Use: conditional formatting - red when below the portfolio margin hurdle.

Revenue YoY Label =
VAR _g = [Revenue Growth %]
RETURN
    IF ( ISBLANK ( _g ), "Select one year to compare with the prior year",
         IF ( _g >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _g ), "0.0%" ) & " vs prior year" )
// Use: KPI card reference label.

Profit YoY Label =
VAR _g = [Profit Growth %]
VAR _chg = [Profit Change]
RETURN
    SWITCH ( TRUE (),
        NOT ISBLANK ( _g ), IF ( _g >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _g ), "0.0%" ) & " vs prior year",
        NOT ISBLANK ( _chg ), "Change " & FORMAT ( _chg, "#,0" ) & " vs prior year",
        "Select one year to compare with the prior year" )
// Use: KPI card reference label (falls back to the absolute change when % growth is undefined).

Margin Change Label =
VAR _c = [Margin Change pp]
RETURN
    IF ( ISBLANK ( _c ), "Select one year to compare with the prior year",
         IF ( _c >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _c ) * 100, "0.0" ) & " pp vs prior year" )
// Use: KPI card reference label.

Report Context Title =
VAR _years = IF ( ISFILTERED ( dim_date[year] ),
                  CONCATENATEX ( VALUES ( dim_date[year] ), dim_date[year], ", ", dim_date[year], ASC ), "All years" )
VAR _region = IF ( ISFILTERED ( dim_location[region] ),
                   CONCATENATEX ( VALUES ( dim_location[region] ), dim_location[region], ", " ), "All regions" )
VAR _cat = IF ( ISFILTERED ( dim_product[category] ),
                CONCATENATEX ( VALUES ( dim_product[category] ), dim_product[category], ", " ), "All categories" )
RETURN
    _years & "  |  " & _region & "  |  " & _cat
// Use: filter-context card in the header.

Data Scope Note =
"Core scope: US order lines; suspected copied Canadian records excluded. Dataset years are synthetic."
// Use: footer card on every page.


// ---------- Folder: 7 Insight text --------------------------------------------

Insight Break-even =
"Lines sold beyond their product's break-even discount are "
    & FORMAT ( [Beyond Break-even Revenue %], "0%" ) & " of revenue and produce "
    & FORMAT ( [Profit Beyond Break-even], "#,0" ) & " profit."
// Use: key findings card (page 5).

Insight Discount Margin =
"Margin is " & FORMAT ( CALCULATE ( [Profit Margin %], dim_discount[discount_rate] = 0 ), "0.0%" )
    & " at full price and " & FORMAT ( CALCULATE ( [Profit Margin %], dim_discount[discount_rate] >= 0.3 ), "0.0%" )
    & " at 30%+ discount."
// Use: key findings card (page 5).

Insight Customer Concentration =
"The top 10% of customers generate " & FORMAT ( [Top 10% Customer Profit Share], "0%" )
    & " of customer profit."
// Use: key findings card (page 5).

Insight Loss Rules =
FORMAT ( [Loss-making Rules], "0" ) & " state x sub-category discount rules are loss-making, losing "
    & FORMAT ( - [Loss from Loss-making Rules], "#,0" ) & " in total."
// Use: key findings card (page 5).


